# Local E2E configuration
# Copy to .env.e2e. The destination is ignored by Git.
# See e2e/README.md for backend-owned seeding and service startup guidance.

# Required exact localhost origins. Frontend: 3100. Backend: 3000.
E2E_BASE_URL=http://localhost:3100
E2E_API_URL=http://localhost:3000

# Required Owner credentials. Keep values blank in this tracked template.
# They must match the test user created by the backend repository's seed.
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=

# Optional Manager pair. Set both or leave both blank; partial configuration
# produces a visible coverage-skip warning without blocking the Owner smoke.
E2E_MANAGER_EMAIL=
E2E_MANAGER_PASSWORD=

# Optional token consumed by legacy fixture data. Keep blank unless a local,
# isolated integration scenario explicitly requires it.
E2E_WB_TOKEN=

# Mutating specs remain excluded by default. See e2e/README.md before changing.
E2E_ENABLE_MUTATIONS=
E2E_MUTATION_TARGET=
E2E_MUTATION_ACK=
