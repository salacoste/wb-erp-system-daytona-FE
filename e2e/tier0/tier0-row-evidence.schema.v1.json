{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:wb-repricer:tier0-row-evidence:v1",
  "title": "Tier-0 terminal row evidence v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "registry_version",
    "run_id",
    "row_id",
    "status",
    "reason_code",
    "failure_class",
    "started_at",
    "finished_at",
    "environment",
    "rcsm_sha256",
    "runtime_input_sha256",
    "revision",
    "source_tree_sha256",
    "command",
    "command_sha256",
    "cwd",
    "exit_code",
    "evidence_paths",
    "evidence_sha256",
    "cleanup_status",
    "dependencies"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "registry_version": { "const": "tier0-v1" },
    "run_id": { "type": "string", "minLength": 1 },
    "row_id": { "type": "string", "pattern": "^(PRE-I|RT-E|OI-E|OBS-I)[0-9]{2}$" },
    "status": { "enum": ["PASS", "FAIL", "BLOCKED"] },
    "reason_code": { "type": "string", "minLength": 1 },
    "failure_class": { "enum": ["none", "prerequisite", "product", "infrastructure", "runner"] },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "environment": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "deployment_id", "contract_version"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "deployment_id": { "type": "string", "minLength": 1 },
        "contract_version": { "type": "string", "minLength": 1 }
      }
    },
    "rcsm_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "runtime_input_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "revision": { "type": "string", "pattern": "^[a-f0-9]{40}([a-f0-9]{24})?$" },
    "source_tree_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "command": { "type": "string", "minLength": 1 },
    "command_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "cwd": { "type": "string", "minLength": 1 },
    "exit_code": { "type": ["integer", "null"] },
    "evidence_paths": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "evidence_sha256": {
      "type": "array",
      "items": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
    },
    "dependencies": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "cleanup_status": { "enum": ["not-applicable", "not-started", "complete", "failed"] }
  }
}
