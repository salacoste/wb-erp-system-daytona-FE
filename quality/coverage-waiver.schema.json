{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-waiver.v1",
  "type": "object",
  "required": [
    "$schema",
    "schemaVersion",
    "mode",
    "owner",
    "issue",
    "reason",
    "metrics",
    "scope",
    "baselineReduction",
    "controls",
    "revocation",
    "created_at",
    "expires_at",
    "approvals"
  ],
  "properties": {
    "$schema": { "const": "../coverage-waiver.schema.json" },
    "schemaVersion": { "const": 1 },
    "mode": { "const": "waiver" },
    "owner": { "type": "string", "minLength": 1 },
    "issue": { "type": "string", "minLength": 1 },
    "reason": { "type": "string", "minLength": 1 },
    "metrics": {
      "const": ["statements", "branches", "functions", "lines"]
    },
    "scope": { "const": "frontend-global-coverage-non-regression" },
    "baselineReduction": { "const": false },
    "controls": { "type": "string", "minLength": 1 },
    "revocation": { "type": "string", "minLength": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "expires_at": { "type": "string", "format": "date-time" },
    "approvals": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": ["name", "role", "approved_at"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "role": { "enum": ["Frontend Tech Lead", "QA Owner"] },
          "approved_at": { "type": "string", "format": "date-time" }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
