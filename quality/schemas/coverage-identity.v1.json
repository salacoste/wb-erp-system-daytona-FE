{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-identity.v1",
  "type": "object",
  "required": [
    "provider",
    "scopeDigest",
    "resolvedTestPathDigest",
    "source",
    "lockDigest",
    "policyMode",
    "policyPath",
    "policyDigest",
    "policySelectionDigest"
  ],
  "properties": {
    "waiverValidationDigest": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
