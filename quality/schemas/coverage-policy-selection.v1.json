{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "coverage-policy-selection.v1",
  "oneOf": [
    {
      "type": "object",
      "required": ["$schema", "schemaVersion", "mode", "thresholdPolicy", "waiver"],
      "properties": {
        "$schema": { "const": "./schemas/coverage-policy-selection.v1.json" },
        "schemaVersion": { "const": 1 },
        "mode": { "const": "threshold" },
        "thresholdPolicy": { "const": "quality/coverage-policy.v1.json" },
        "waiver": { "type": "null" }
      },
      "additionalProperties": false
    },
    {
      "type": "object",
      "required": ["$schema", "schemaVersion", "mode", "thresholdPolicy", "waiver"],
      "properties": {
        "$schema": { "const": "./schemas/coverage-policy-selection.v1.json" },
        "schemaVersion": { "const": 1 },
        "mode": { "const": "waiver" },
        "thresholdPolicy": { "type": "null" },
        "waiver": {
          "type": "string",
          "pattern": "^quality/coverage-waivers/[A-Za-z0-9](?:[A-Za-z0-9_-]*[A-Za-z0-9])?\\.v1\\.json$"
        }
      },
      "additionalProperties": false
    }
  ]
}
