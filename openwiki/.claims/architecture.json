    {
      "id": "claim_e1495c654c184f439648778118633df2",
      "statement": "src/proxy.ts implements the Next.js 16 proxy (renamed from middleware) auth gate: it reads the auth-token cookie (falling back to the Authorization header), and protected routes without a structurally valid JWT redirect to /login with a redirect param; its matcher excludes /api, _next assets, favicon, and static image files.",
      "evidence": [
