    {
      "id": "claim_236f1a0214cc42f7ad9a1b3cffe63a03",
      "statement": "On a 401 to an authenticated non-refresh request, apiClient calls getFreshToken (single-flight core in api-client-refresh.ts): concurrent 401s join one POST /v1/auth/refresh, the refresh reads the token from the auth store at refresh time (never the failed request's revoked token), updates the store via the refreshToken store action preserving sessionNonce and user, and enforces a 10s abort deadline so a black-holed refresh cannot wedge recovery.",
      "evidence": [
        {
          "resource": "repo://src/lib/api-client-refresh.ts#L34-L123",
          "version": "repo-lines-v1:sha256:713b91cabf5ff2df52d90bbccbd03f9b000f964b9b59105e24ddfc293cbce5d1:"
